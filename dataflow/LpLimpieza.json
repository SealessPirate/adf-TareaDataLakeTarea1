{
	"name": "LpLimpieza",
	"properties": {
		"folder": {
			"name": "Bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ventas_lp_city",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SantaCruzVentasLimpio",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "ArreglarFecha"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ID_Venta as string,",
				"          Fecha_Venta as string,",
				"          Producto as string,",
				"          Cant as string,",
				"          PrecioUnit as string,",
				"          Sucursal as string,",
				"          Vendedor as string,",
				"          NombreCliente as string,",
				"          EmailCliente as string,",
				"          MetodoPago as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 select(mapColumn(",
				"          id_venta = ID_Venta,",
				"          fecha = Fecha_Venta,",
				"          producto = Producto,",
				"          cantidad = Cant,",
				"          precio_unitario = PrecioUnit,",
				"          sucursal = Sucursal,",
				"          vendedor = Vendedor,",
				"          nombre_cliente = NombreCliente,",
				"          email_cliente = EmailCliente,",
				"          metodo_pago = MetodoPago",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(id_venta = trim(id_venta),",
				"          fecha = trim(fecha),",
				"          producto = trim(producto),",
				"          cantidad = trim(cantidad),",
				"          precio_unitario = trim(precio_unitario),",
				"          sucursal = trim(sucursal),",
				"          vendedor = trim(vendedor),",
				"          nombre_cliente = trim(nombre_cliente),",
				"          email_cliente = trim(email_cliente),",
				"          metodo_pago = trim(metodo_pago),",
				"          canal = 'Sucursal') ~> derivedColumn1",
				"derivedColumn1 derive(sucursal = iif(in(    [\"LPZ\",\"Lapaz\",    \"La Paz\",    \"LA PAZ\",    \"LP\",    \"la paz\",    \"lp\",    \"lapaz\",    \"L.P.\",    \"LaPaz\"    ],sucursal    ),'La Paz',sucursal),",
				"          cantidad = toInteger(cantidad)) ~> derivedColumn2",
				"derivedColumn2 derive(fecha = coalesce(\r",
				"    toDate(fecha,'yyyy-MM-dd'),\r",
				"    toDate(fecha,'dd-MM-yyyy'),\r",
				"    toDate(fecha,'dd-MM-yyyy'),\r",
				"    toDate(fecha,'MM-dd-yyyy'),\r",
				"    toDate(fecha,'dd-MMM-yyyy'),\r",
				"    toDate(fecha,'yyyy-dd-MM'),\r",
				"    toDate(fecha,'MMM-dd-yyyy'),\r",
				"    toDate(fecha,'yyyy-dd-MMM'),\r",
				"    \r",
				"    toDate(fecha,'yyyy/MM/dd'),\r",
				"    toDate(fecha,'dd/MM/yyyy'),\r",
				"    toDate(fecha,'dd/MM/yyyy'),\r",
				"    toDate(fecha,'MM/dd/yyyy'),\r",
				"    toDate(fecha,'dd/MMM/yyyy'),\r",
				"    toDate(fecha,'yyyy/dd/MM'),\r",
				"    toDate(fecha,'MMM/dd/yyyy'),\r",
				"    toDate(fecha,'yyyy/dd/MMM')\r",
				")) ~> ArreglarFecha",
				"ArreglarFecha derive(producto = initCap(regexReplace(producto,'\\\\s+',' ')),",
				"          precio_unitario = toFloat(regexReplace(toString(precio_unitario), '[^0-9.]',''))) ~> derivedColumn3",
				"derivedColumn3 filter(cantidad>0&&!isNull(precio_unitario)&&!isNull(fecha)) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['LaPazVentasLimpio'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}