{
	"name": "dataflow1",
	"properties": {
		"folder": {
			"name": "Bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ventas_Santapue",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "derivedColumn5"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_venta as string,",
				"          fecha as string,",
				"          producto as string,",
				"          cantidad as string,",
				"          precio_unitario as string,",
				"          sucursal as string,",
				"          vendedor as string,",
				"          cliente_nombre as string,",
				"          cliente_email as string,",
				"          metodo_pago as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(vendedor = trim(vendedor),",
				"          cliente_nombre = trim(cliente_nombre),",
				"          fecha = trim(fecha),",
				"          producto = trim(producto),",
				"          cantidad = trim(cantidad),",
				"          cliente_email = trim(cliente_email),",
				"          sucursal = trim(sucursal),",
				"          precio_unitario = trim(precio_unitario),",
				"          id_venta = trim(id_venta),",
				"          metodo_pago = trim(metodo_pago)) ~> derivedColumn1",
				"derivedColumn1 derive(producto = initCap(regexReplace(producto,'\\\\s+',' '))) ~> derivedColumn2",
				"derivedColumn2 derive(sucursal = iif(in(['SZ','SCZ','Santa Cruz','Sta Cruz','Sta. Cruz','santa cruz','SANTA CRUZ','SC','Santa','SANTA'],sucursal), 'Santa Cruz',sucursal)) ~> derivedColumn3",
				"derivedColumn3 derive(precio_unitario = toFloat(regexReplace(toString(precio_unitario), '[^0-9.]',''))\r",
				",",
				"          cantidad = toInteger(cantidad)) ~> derivedColumn4",
				"derivedColumn4 derive(fecha = coalesce(toDate(fecha,'yyyy-MM-dd'),toDate(fecha,'dd-MM-yyyy'),toDate(fecha,'dd-MMM-yyyy'),toDate(fecha,'dd/MM/yyyy'),toDate(fecha,'MM/dd/yyyy'),toDate(fecha,'MM-dd-yyyy'),toDate(fecha,'MMM-dd-yyyy'),toDate(fecha,'MMM/dd/yyyy'),toDate(fecha,'MM-dd-yyyy'),toDate(fecha,'dd-MMM-yyyy'),toDate(fecha,'dd/MMM/yyyy'),toDate(fecha,'yyyy/MM/dd'))) ~> derivedColumn5",
				"derivedColumn5 filter(cantidad>0&&!isNull(precio_unitario)&&!isNull(fecha)) ~> filter1"
			]
		}
	}
}